{
	"name": "footprint",
	"displayName": "Footprint",
	"description": "Automatic visual identity for VS Code workspaces.",
	"version": "1.1.4",
	"publisher": "waka",
	"repository": {
		"type": "git",
		"url": "https://github.com/below43/footprint.git"
	},
	"license": "MIT",
	"engines": {
		"vscode": "^1.104.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"workspace",
		"color",
		"colour",
		"visual identity",
		"window",
		"productivity"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"icon": "images/logo.png",
	"galleryBanner": {
		"color": "#101827",
		"theme": "dark"
	},
	"homepage": "https://waka.nz",
	"bugs": {
		"url": "https://github.com/below43/footprint/issues"
	},
	"contributes": {
		"commands": [
			{
				"command": "footprint.workspaceColor",
				"title": "Footprint: Workspace Color"
			}
		],
		"configuration": {
			"title": "Footprint",
			"properties": {
				"footprint.enableStatusBarColor": {
					"type": "boolean",
					"default": true,
					"description": "Apply the Footprint color to the VS Code Status Bar."
				}
			}
		}
	},
	"scripts": {
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"test": "tsc -p tsconfig.test.json && mocha \"dist-test/test/**/*.test.js\"",
		"package": "npm run compile && npx @vscode/vsce package"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.15.0",
		"@types/vscode": "^1.104.0",
		"@vscode/test-electron": "^2.5.2",
		"@vscode/vsce": "^3.6.0",
		"mocha": "^11.7.1",
		"typescript": "^5.9.2"
	}
}